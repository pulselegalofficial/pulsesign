---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import LangToggle from '../components/LangToggle.astro';
import { dict } from '../lib/i18n';
if (Astro.locals.user) return Astro.redirect('/');
const t = dict(Astro.locals.lang);
const next = Astro.url.searchParams.get('next') || '';
const errors: Record<string, string> = {
  not_allowed: t.loginNotAllowed,
  google: t.loginFailed,
  state: t.loginFailed,
  not_configured: t.loginNotConfigured,
};
const error = errors[Astro.url.searchParams.get('error') || ''];
const href = `/api/auth/google${next ? `?next=${encodeURIComponent(next)}` : ''}`;
---
<Base title={t.loginTitle}>
  <div class="login">
    <section class="hero">
      <Logo />
      <div>
        <h1>{t.loginHero}</h1>
        <p>{t.loginHeroSub}</p>
      </div>
    </section>
    <section class="panel">
      <div class="box">
        <div class="box-head">
          <span class="mobile-logo"><Logo size={30} /></span>
          <LangToggle />
        </div>
        <h2 class="title">{t.loginTitle}</h2>
        <p class="muted">{t.loginSub}</p>
        {error && <p class="error" role="alert">{error}</p>}
        <a class="btn btn-block btn-lg google" href={href} id="google-btn">
          <svg width="20" height="20" viewBox="0 0 48 48" aria-hidden="true">
            <path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.4-.4-3.5z"/>
            <path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/>
            <path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-8l-6.5 5C9.5 39.6 16.2 44 24 44z"/>
            <path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.4-.4-3.5z"/>
          </svg>
          {t.google}
        </a>
        <p class="small muted" style="margin-top:14px">{t.loginNote}</p>
        <p class="small faint" style="margin-top:22px">{t.terms}</p>
      </div>
    </section>
  </div>
</Base>

<style>
  .login {
    min-height: 100vh;
    display: grid;
    grid-template-columns: 1fr 1fr;
  }
  .hero {
    background: var(--forest);
    color: #fff;
    padding: 56px;
    display: flex;
    flex-direction: column;
    gap: 140px;
  }
  .hero :global(.logo) {
    color: #fff;
  }
  .hero :global(.logo-mark) {
    background: #eef5f0;
  }
  .hero h1 {
    font-size: 40px;
    max-width: 520px;
    line-height: 1.35;
  }
  .hero p {
    color: #cfe7d8;
    max-width: 480px;
    font-size: 17px;
    line-height: 1.7;
    margin-top: 20px;
  }
  .panel {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px 24px;
  }
  .box {
    width: 100%;
    max-width: 400px;
  }
  .box-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 36px;
  }
  .mobile-logo {
    visibility: hidden;
  }
  .title {
    font-size: 30px;
    margin-bottom: 6px;
  }
  .error {
    color: var(--danger);
    background: var(--danger-bg);
    border-radius: 14px;
    padding: 12px 14px;
    margin: 18px 0 0;
  }
  .google {
    margin-top: 26px;
    background: #fff;
    color: var(--ink);
    border: 1.5px solid var(--mint-line);
    gap: 12px;
  }
  .google:hover {
    color: var(--ink);
    border-color: var(--forest);
    filter: none;
  }
  @media (max-width: 860px) {
    .login {
      grid-template-columns: 1fr;
    }
    .hero {
      display: none;
    }
    .mobile-logo {
      visibility: visible;
    }
    .panel {
      align-items: flex-start;
      padding-top: 28px;
    }
  }
</style>
