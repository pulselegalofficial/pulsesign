---
import App from '../../layouts/App.astro';
import StatusChip from '../../components/StatusChip.astro';
import { actorLabel, dict, fill } from '../../lib/i18n';
import {
  MAX_ATTACHMENT_BYTES,
  attachmentInline,
  expireDue,
  getDoc,
  getEvents,
  getSigners,
  getUser,
  listAttachments,
  listFolders,
} from '../../lib/docs';
import { displayName } from '../../lib/auth';
import { describeUserAgent, formatBytes, formatDate } from '../../lib/format';

const lang = Astro.locals.lang;
const t = dict(lang);
await expireDue();
const doc = await getDoc(Astro.params.id!);
if (!doc) return Astro.redirect('/');
if (doc.status === 'draft') return Astro.redirect(`/new?id=${doc.id}`);
const [signers, events, attachmentRows, folders] = await Promise.all([getSigners(doc.id), getEvents(doc.id), listAttachments(doc.id), listFolders()]);
const uploaders = new Map(await Promise.all([...new Set(attachmentRows.map((a) => a.uploaded_by))].map(async (e) => [e, displayName(await getUser(e))] as const)));
const attachments = attachmentRows.map((a) => ({
  id: a.id,
  name: a.name,
  note: a.note,
  size: formatBytes(a.size),
  sha256: a.sha256,
  href: `/api/docs/${doc.id}/attachments/${a.id}`,
  inline: attachmentInline(a.content_type),
  by: fill(t.attBy, { who: uploaders.get(a.uploaded_by) || a.uploaded_by, time: formatDate(a.created_at, lang, { time: true }) }),
}));
const active = doc.status === 'sent' || doc.status === 'opened';
const tt = t as Record<string, string>;
const kind = (type: string) =>
  ['signed', 'stamped', 'completed'].includes(type) ? 'good' : ['opened', 'otp_verified', 'consent', 'otp_sent'].includes(type) ? 'warm' : ['declined', 'cancelled', 'expired', 'otp_failed'].includes(type) ? 'bad' : 'base';
const evs = events.map((e) => ({
  label: fill(tt[`ev_${e.type}`] || e.type, { name: e.detail || '' }),
  extra: e.type === 'declined' && e.detail ? `${t.declineReasonLabel}: “${e.detail}”` : '',
  who: actorLabel(e.actor_name, lang),
  time: `${formatDate(e.at, lang, { time: true, seconds: true })} (GMT+7)`,
  meta: e.ip ? `IP ${e.ip} · ${describeUserAgent(e.user_agent)}` : '',
  kind: kind(e.type),
}));
const justSent = Astro.url.searchParams.has('sent');
const finalPending = doc.status === 'completed' && !doc.final_key;
---
<App title={doc.title} clientStrings>
  <a class="back-link" href="/">← {t.backDocs}</a>
  <div class="meta">
    <StatusChip status={doc.status} />
    <span class="mono faint small">{doc.id}</span>
  </div>
  <h1 class="doc-title">{doc.title}</h1>
  <div class="actions">
    {doc.final_key && <a class="btn" href={`/api/docs/${doc.id}/signed?download`}>{t.download}</a>}
    {doc.final_key && <a class="btn btn-ghost" href={`/api/docs/${doc.id}/signed#page=${doc.pages + 1}`} target="_blank" rel="noopener">{t.downloadCert}</a>}
    {active && <button class="btn" type="button" id="remind">{t.resend}</button>}
    <a class="btn btn-ghost" href={`/api/docs/${doc.id}/file`} target="_blank" rel="noopener">{t.downloadOriginal}</a>
    {active && <button class="btn btn-danger" type="button" id="cancel">{t.cancelReq}</button>}
    <button class="btn btn-danger delete-btn" type="button" id="delete">{t.deleteDoc}</button>
  </div>

  {
    finalPending && (
      <div class="card finalizing" id="finalizing">
        <span class="spinner" />
        <div>
          <strong id="fin-title">{t.finalizing}</strong>
          <p class="small muted" id="fin-note">{t.finalizingNote}</p>
        </div>
        <button class="btn btn-sm" type="button" id="fin-retry" hidden>{t.retry}</button>
      </div>
    )
  }

  <div class="grid">
    <section class="card audit">
      <div class="audit-head">
        <h2>{t.audit}</h2>
        <span class="small muted">{evs.length} {t.events}</span>
      </div>
      <ol class="timeline">
        {
          evs.map((e) => (
            <li class={`ev ${e.kind}`}>
              <span class="ev-dot" />
              <div>
                <strong>{e.label}</strong>
                {e.extra && <div class="small" style="color:var(--danger)">{e.extra}</div>}
                <div class="small muted">{e.who}</div>
                <div class="mono small ev-meta">{e.time}</div>
                {e.meta && <div class="mono small ev-meta">{e.meta}</div>}
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <aside class="side-col">
      <section class="card">
        <h2>{t.signersProg}</h2>
        <div class="signers">
          {
            signers.map((s) => (
              <div class="signer">
                <span class="num-dot" style={s.status === 'signed' ? 'background:var(--forest);color:#fff' : 'background:var(--mint)'}>
                  {s.position + 1}
                </span>
                <div class="who">
                  <strong>{s.name}</strong>
                  <span class="small muted">{s.email}</span>
                  {s.signed_at && <span class="small faint">{formatDate(s.signed_at, lang, { time: true })}</span>}
                </div>
                <StatusChip status={s.status} kind="signer" />
              </div>
            ))
          }
        </div>
      </section>
      {
        doc.status === 'completed' && (
          <section class="card">
            <label class="side-h2" for="folder-select">{t.folderLabel}</label>
            <select class="input folder-select" id="folder-select">
              <option value="" selected={!doc.folder_id}>{t.folderNone}</option>
              {folders.map((f) => (
                <option value={f.id} selected={doc.folder_id === f.id}>{f.name}</option>
              ))}
            </select>
          </section>
        )
      }
      <section class="card">
        <div class="att-head">
          <h2>{t.attachments}</h2>
          <span class="small muted">{attachments.length || ''}</span>
        </div>
        <p class="small muted att-sub">{t.attSub}</p>
        <ul class="att-list" id="att-list">
          {
            attachments.map((a) => (
              <li class="att" data-att={a.id} data-name={a.name}>
                <span class="att-icon" aria-hidden="true">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5l-8.6 8.6a5.5 5.5 0 01-7.8-7.8l9-9a3.7 3.7 0 015.2 5.2l-9 9a1.8 1.8 0 01-2.6-2.6l8.3-8.3" /></svg>
                </span>
                <div class="att-main">
                  <a href={a.href} target={a.inline ? '_blank' : undefined} rel="noopener" class="att-name">{a.name}</a>
                  {a.note && <span class="small att-note">{a.note}</span>}
                  <span class="small faint">{a.size} · {a.by}</span>
                  <span class="mono att-hash" title="SHA-256">{a.sha256}</span>
                </div>
                <button class="link-btn small att-del" type="button" data-del={a.id}>{t.attDelete}</button>
              </li>
            ))
          }
        </ul>
        {attachments.length === 0 && <p class="small faint att-empty" id="att-empty">{t.attEmptyList}</p>}
        <input class="input att-note-input" id="att-note" maxlength="300" placeholder={t.attNotePh} autocomplete="off" />
        <label class="btn btn-soft btn-block att-add">
          <input type="file" id="att-file" class="sr-only" multiple />
          + {t.attAdd}
        </label>
        <p class="small muted" id="att-status" hidden></p>
      </section>
      <section class="card">
        <h2>{t.evidence}</h2>
        <span class="label" style="margin-top:16px">{t.hashBefore}</span>
        <div class="hash">{doc.hash_before}</div>
        <span class="label" style="margin-top:16px">{t.hashAfter}</span>
        <div class="hash" style={doc.hash_final ? 'color:var(--forest)' : 'color:var(--faint);font-family:var(--font)'}>{doc.hash_final || t.pending}</div>
        <span class="chip chip-sent" style="margin-top:16px">{t.storage}</span>
      </section>
    </aside>
  </div>

  <div class="overlay" id="delete-dialog" hidden>
    <form class="modal" id="delete-form">
      <h2>{t.deleteTitle}</h2>
      <p class="muted">{t.deleteBody}</p>
      <p class="small faint">{t.deleteNote}</p>
      <div class="field" style="margin-top:18px">
        <label for="delete-id">{fill(t.deleteTypeId, { id: doc.id })}</label>
        <input class="input mono" id="delete-id" autocomplete="off" placeholder={doc.id} />
      </div>
      <div style="display:flex;gap:10px;justify-content:flex-end;margin-top:20px">
        <button class="btn btn-soft" type="button" data-close>{t.cancel}</button>
        <button class="btn btn-danger-solid" type="submit" id="confirm-delete" disabled>{t.deleteConfirm}</button>
      </div>
    </form>
  </div>

  <div class="overlay" id="cancel-dialog" hidden>
    <div class="modal">
      <h2>{t.cancelTitle}</h2>
      <p class="muted">{t.cancelBody}</p>
      <div style="display:flex;gap:10px;justify-content:flex-end;margin-top:20px">
        <button class="btn btn-soft" type="button" data-close>{t.keep}</button>
        <button class="btn btn-danger-solid" type="button" id="confirm-cancel">{t.confirmCancel}</button>
      </div>
    </div>
  </div>
  <script type="application/json" id="detail-config" set:html={JSON.stringify({ id: doc.id, justSent, finalPending, maxAtt: MAX_ATTACHMENT_BYTES })} />
</App>

<script>
  import { ApiError, api, fill, strings, toast } from '../../scripts/ui';
  import { sha256Hex } from '../../scripts/pdfwork';
  const t = strings();
  const { id, justSent, finalPending, maxAtt } = JSON.parse(document.getElementById('detail-config')!.textContent!);
  const errText = (e: unknown) => (e instanceof ApiError && t[e.code] ? t[e.code] : t.errGeneric);

  // ─── Folder ───
  const folderSelect = document.getElementById('folder-select') as HTMLSelectElement | null;
  folderSelect?.addEventListener('change', async () => {
    const value = folderSelect.value;
    try {
      await api(`/api/docs/${id}/folder`, { method: 'PUT', json: { folderId: value || null } });
      toast(value ? fill(t.folderMoved, { name: folderSelect.selectedOptions[0].text }) : t.folderUnfiled);
    } catch (e) {
      toast(errText(e), true);
    }
  });

  // ─── Attachments (kept beside the document; the signed PDF and its hash are untouched) ───
  const attFile = document.getElementById('att-file') as HTMLInputElement;
  const attStatus = document.getElementById('att-status')!;
  attFile.addEventListener('change', async () => {
    const list = [...(attFile.files || [])];
    attFile.value = '';
    if (!list.length) return;
    const note = (document.getElementById('att-note') as HTMLInputElement).value.trim();
    let added = 0;
    attFile.disabled = true;
    for (const file of list) {
      if (file.size > maxAtt) {
        toast(`${file.name}: ${t.attTooLarge}`, true);
        continue;
      }
      attStatus.hidden = false;
      attStatus.textContent = fill(t.attUploading, { name: file.name });
      try {
        const bytes = new Uint8Array(await file.arrayBuffer());
        await api(`/api/docs/${id}/attachments`, {
          method: 'POST',
          body: bytes as BodyInit,
          headers: {
            'content-type': file.type || 'application/octet-stream',
            'x-file-name': encodeURIComponent(file.name),
            'x-note': encodeURIComponent(note),
            'x-sha256': await sha256Hex(bytes),
          },
        });
        added++;
      } catch (e) {
        toast(`${file.name}: ${errText(e)}`, true);
      }
    }
    attFile.disabled = false;
    attStatus.hidden = true;
    if (added) {
      toast(fill(t.attAdded, { n: added }));
      setTimeout(() => location.reload(), 700);
    }
  });
  document.querySelectorAll<HTMLButtonElement>('[data-del]').forEach((b) =>
    b.addEventListener('click', async () => {
      const li = b.closest<HTMLElement>('.att')!;
      if (!confirm(fill(t.attDeleteConfirm, { name: li.dataset.name || '' }))) return;
      try {
        await api(`/api/docs/${id}/attachments/${b.dataset.del}`, { method: 'DELETE' });
        li.remove();
        toast(t.attDeleted);
      } catch (e) {
        toast(errText(e), true);
      }
    })
  );
  if (justSent) {
    toast(t.sentToast);
    history.replaceState(null, '', location.pathname);
  }
  document.getElementById('remind')?.addEventListener('click', async (e) => {
    const b = e.currentTarget as HTMLButtonElement;
    b.disabled = true;
    try {
      await api(`/api/docs/${id}/remind`, { method: 'POST' });
      toast(t.resentToast);
      setTimeout(() => location.reload(), 900);
    } catch {
      toast(t.errGeneric, true);
      b.disabled = false;
    }
  });
  const delDialog = document.getElementById('delete-dialog')!;
  const delInput = document.getElementById('delete-id') as HTMLInputElement;
  const delBtn = document.getElementById('confirm-delete') as HTMLButtonElement;
  document.getElementById('delete')!.addEventListener('click', () => {
    delInput.value = '';
    delBtn.disabled = true;
    delDialog.hidden = false;
    delInput.focus();
  });
  delDialog.addEventListener('click', (e) => {
    if (e.target === delDialog || (e.target as HTMLElement).closest('[data-close]')) delDialog.hidden = true;
  });
  delInput.addEventListener('input', () => (delBtn.disabled = delInput.value.trim().toUpperCase() !== id));
  document.getElementById('delete-form')!.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (delBtn.disabled) return;
    delBtn.disabled = true;
    try {
      await api(`/api/docs/${id}?confirm=${encodeURIComponent(id)}`, { method: 'DELETE' });
      location.href = `/?deleted=${encodeURIComponent(id)}`;
    } catch {
      toast(t.errGeneric, true);
      delBtn.disabled = false;
    }
  });
  const dialog = document.getElementById('cancel-dialog')!;
  document.getElementById('cancel')?.addEventListener('click', () => (dialog.hidden = false));
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog || (e.target as HTMLElement).closest('[data-close]')) dialog.hidden = true;
  });
  document.getElementById('confirm-cancel')!.addEventListener('click', async () => {
    try {
      await api(`/api/docs/${id}/cancel`, { method: 'POST' });
      location.reload();
    } catch {
      toast(t.errGeneric, true);
    }
  });
  // Everyone has signed: this browser builds the final PDF (PDF_MODE=browser).
  async function finalize() {
    const retry = document.getElementById('fin-retry')!;
    retry.hidden = true;
    document.getElementById('fin-title')!.textContent = t.finalizing;
    document.getElementById('finalizing')!.classList.remove('failed');
    try {
      const { finalizeDocument } = await import('../../scripts/pdfwork');
      await finalizeDocument(id);
      location.reload();
    } catch (e) {
      if (e instanceof ApiError && e.code === 'not_needed') return location.reload();
      console.error(e);
      document.getElementById('fin-title')!.textContent = t.finalizeFailed;
      document.getElementById('finalizing')!.classList.add('failed');
      retry.hidden = false;
    }
  }
  if (finalPending) {
    document.getElementById('fin-retry')!.addEventListener('click', finalize);
    void finalize();
  }
</script>

<style>
  .back-link {
    display: inline-block;
    font-weight: 600;
    text-decoration: none;
    margin-bottom: 18px;
  }
  .meta {
    display: flex;
    gap: 10px;
    align-items: center;
  }
  .doc-title {
    margin: 10px 0 16px;
    font-size: 28px;
  }
  .actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 22px;
  }
  .finalizing {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 20px;
    background: var(--peach-2);
    border: 1.5px solid var(--peach);
  }
  .finalizing div {
    flex: 1;
  }
  .finalizing p {
    margin: 2px 0 0;
  }
  .finalizing.failed .spinner {
    display: none;
  }
  .spinner {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    border: 3px solid var(--peach);
    border-top-color: var(--pulse);
    animation: spin 0.8s linear infinite;
    flex: none;
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 380px;
    gap: 20px;
    align-items: start;
  }
  .side-col {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .audit-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 14px;
  }
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .ev {
    display: grid;
    grid-template-columns: 22px 1fr;
    gap: 10px;
    position: relative;
    padding-bottom: 18px;
  }
  .ev:not(:last-child)::before {
    content: '';
    position: absolute;
    left: 10px;
    top: 22px;
    bottom: 2px;
    width: 2px;
    background: var(--mint-line);
  }
  .ev-dot {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    border: 5px solid #e6f2ea;
    background: var(--sage);
    margin-top: 1px;
  }
  .ev.good .ev-dot {
    background: var(--forest);
    border-color: var(--mint);
  }
  .ev.warm .ev-dot {
    background: var(--pulse);
    border-color: var(--peach);
  }
  .ev.bad .ev-dot {
    background: var(--danger);
    border-color: var(--danger-bg);
  }
  .ev-meta {
    color: var(--muted);
    font-size: 12px;
  }
  .signers {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 14px;
  }
  .signer {
    display: flex;
    align-items: center;
    gap: 12px;
    background: var(--mint-3);
    border-radius: 16px;
    padding: 12px;
  }
  .who {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }
  .who span {
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .delete-btn {
    margin-left: auto;
  }
  .side-h2 {
    display: block;
    font-family: var(--font-head);
    font-size: 19px;
    font-weight: 600;
    color: var(--ink);
    margin: 0 0 12px;
  }
  .folder-select {
    appearance: auto;
  }
  .att-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }
  .att-sub {
    margin: 6px 0 12px;
  }
  .att-list {
    list-style: none;
    margin: 0 0 12px;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .att {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    background: var(--mint-3);
    border-radius: 14px;
    padding: 10px 12px;
  }
  .att-icon {
    color: var(--forest);
    margin-top: 3px;
    flex: none;
  }
  .att-main {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }
  .att-name {
    font-weight: 600;
    text-decoration: none;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .att-note {
    color: var(--ink-2);
  }
  .att-hash {
    font-size: 10.5px;
    color: var(--faint);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .att-del {
    color: var(--danger);
    flex: none;
  }
  .att-empty {
    margin: 0 0 12px;
  }
  .att-note-input {
    margin-bottom: 8px;
  }
  .att-add {
    cursor: pointer;
  }
  .att-add:has(input:disabled) {
    opacity: 0.6;
    pointer-events: none;
  }
  .modal p {
    margin: 10px 0 0;
  }
  @media (max-width: 1000px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .audit {
      order: 2;
    }
    .doc-title {
      font-size: 23px;
    }
  }
</style>
