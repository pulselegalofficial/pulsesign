---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import { dict } from '../lib/i18n';
const t = dict(Astro.locals.lang);
const token = Astro.url.searchParams.get('token') || '';
const next = Astro.url.searchParams.get('next') || '/';
const invalid = Astro.url.searchParams.has('invalid') || !token;
---
<Base title={t.loginTitle}>
  <div class="wrap">
    <div class="card box">
      <Logo />
      {
        invalid ? (
          <>
            <h2>{t.linkInvalid}</h2>
            <a class="btn" href="/login">{t.backToLogin}</a>
          </>
        ) : (
          <form method="post" action="/api/auth/callback">
            <h2>{t.continueSignIn}</h2>
            <p class="muted">{t.continueSignInSub}</p>
            <input type="hidden" name="token" value={token} />
            <input type="hidden" name="next" value={next} />
            <button class="btn btn-block btn-lg" type="submit" autofocus>{t.emLoginBtn}</button>
          </form>
        )
      }
    </div>
  </div>
</Base>
<style>
  .wrap {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px 16px;
  }
  .box {
    width: 100%;
    max-width: 420px;
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  form {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  form p {
    margin: 0 0 8px;
  }
</style>
